    <Item class="ModuleScript" referent="RBX1084">
      <Properties>
        <string name="Name">ToyCatalog</string>
        <ProtectedString name="Source">-- Shared source of truth: probabilities, toy identities, income and speed prices.
local Catalog = {}
Catalog.Order = {"Common", "Rare", "Epic", "Legendary"}
Catalog.Gifts = {
    Common = {Name="Обычный", Color=Color3.fromRGB(91,210,166), Contents={{"Bear",75},{"Bunny",25}}},
    Rare = {Name="Редкий", Color=Color3.fromRGB(80,174,255), Contents={{"MintBunny",35},{"Robot",25},{"RibbonGrin",22},{"WobbleCrank",18}}},
    Epic = {Name="Эпический", Color=Color3.fromRGB(191,121,255), Contents={{"Dino",40},{"Dragon",30},{"PuffMaw",30}}},
    Legendary = {Name="Легендарный", Color=Color3.fromRGB(255,202,76), Contents={{"MoonBear",40},{"StarDragon",25},{"TimberTap",35}}},
}
Catalog.LegacyToyOrder = {"Bear","Bunny","MintBunny","Robot","Dino","Dragon","MoonBear","StarDragon"}
Catalog.ToyOrder = {"Bear","Bunny","MintBunny","Robot","RibbonGrin","WobbleCrank","Dino","Dragon","PuffMaw","MoonBear","StarDragon","TimberTap"}
Catalog.Toys = {
    Bear={Name="Плюшик",Rarity="Common",Income=1},
    Bunny={Name="Прыг-скок",Rarity="Common",Income=2},
    MintBunny={Name="Мятный заяц",Rarity="Rare",Income=4},
    Robot={Name="Бип-Боп",Rarity="Rare",Income=6},
    Dino={Name="Кнопкозавр",Rarity="Epic",Income=10},
    Dragon={Name="Сонный дракон",Rarity="Epic",Income=15},
    MoonBear={Name="Лунный медведь",Rarity="Legendary",Income=25},
    StarDragon={Name="Звездокрыл",Rarity="Legendary",Income=45},
    RibbonGrin={Name="Лапшехохот",Rarity="Rare",Income=7,Motion="Slink"},
    PuffMaw={Name="Пухозуб",Rarity="Epic",Income=14,Motion="Bounce"},
    WobbleCrank={Name="Кривошестер",Rarity="Rare",Income=5,Motion="Windup"},
    TimberTap={Name="Бревнобрык",Rarity="Legendary",Income=32,Motion="Waddle"},
}
Catalog.Zones = {
    {Name="КОВЁР", Keeper="Plush", GuardName="Плюшевый Топотун", Weights={Common=90,Rare=10,Epic=0,Legendary=0}, UpperWeights={Common=55,Rare=45,Epic=0,Legendary=0}, ChaseSeconds=16, ChaseSpeed=17, PatrolSpeed=8, Warning=1.1, Repath=1.2, AgentRadius=3, AgentHeight=11, Motion=3.5},
    {Name="ПОД СТОЛОМ", Keeper="Clockwork", GuardName="Заводной Перекрут", Weights={Common=40,Rare=48,Epic=12,Legendary=0}, UpperWeights={Common=0,Rare=55,Epic=45,Legendary=0}, ChaseSeconds=22, ChaseSpeed=20.5, PatrolSpeed=10, Warning=.4, Repath=.65, AgentRadius=2.7, AgentHeight=10, Motion=7},
    {Name="ЛУННЫЙ УГОЛ", Keeper="Nightmare", GuardName="Кошмарный Ночеглот", Weights={Common=10,Rare=35,Epic=45,Legendary=10}, UpperWeights={Common=0,Rare=15,Epic=60,Legendary=25}, ChaseSeconds=28, ChaseSpeed=23, PatrolSpeed=9, Warning=.7, Repath=.9, AgentRadius=3.8, AgentHeight=14, Motion=4.5},
}
Catalog.Sizes = {
    {Multiplier=1,Name="Обычный",Weight=70,Income=1},
    {Multiplier=1.6,Name="Большой",Weight=22,Income=2},
    {Multiplier=2.5,Name="Гигантский",Weight=7,Income=4},
    {Multiplier=4,Name="Колоссальный",Weight=1,Income=8},
}
Catalog.Boots={Price=300,JumpHeight=14.4,NormalJumpHeight=7.2}
-- Authored world is twice the original dimensions; avatars retain their normal size.
Catalog.WorldScale=2
Catalog.Catch={Windup=.18,FollowThrough=.55,GraceSeconds=2.4,HorizontalSpeed=86,VerticalSpeed=64,
    MaxHorizontalSpeed=90,MaxVerticalSpeed=72,MaxFallSpeed=95,Spin=2.5,LandingDelay=.15,MaxFlightSeconds=2.2}
Catalog.WorldScaleLimit=2.2
Catalog.Speed = {16,19,22,25,28,31}
Catalog.SpeedPrices = {120,360,900,2200,5000}
Catalog.GiftRespawnSeconds = 18
Catalog.VisibleToys = 4
function Catalog.Roll(entries, rng)
    local total=0
    for _,entry in entries do total+=entry[2] end
    local roll=rng:NextNumber(0,total)
    for _,entry in entries do
        if entry[2]&gt;0 then
            roll-=entry[2]
            if roll&lt;=0 then return entry[1] end
        end
    end
    return entries[#entries][1]
end
function Catalog.RollGift(zone, rng, upper)
    local entries={}
    local weights=upper and Catalog.Zones[zone].UpperWeights or Catalog.Zones[zone].Weights
    for _,id in Catalog.Order do table.insert(entries,{id,weights[id]}) end
    return Catalog.Roll(entries,rng)
end
function Catalog.Size(multiplier)
    for _,size in Catalog.Sizes do if size.Multiplier==multiplier then return size end end
    return nil
end
function Catalog.RollSize(rng)
    local entries={}
    for _,size in Catalog.Sizes do table.insert(entries,{size.Multiplier,size.Weight}) end
    return Catalog.Roll(entries,rng)
end
function Catalog.Key(toy,size) return toy.."@"..tostring(size) end
function Catalog.ToyIncome(toy,size) return Catalog.Toys[toy].Income*Catalog.Size(size).Income end
function Catalog.CopyCollection(collection)
    local copy={}
    for i,entry in collection do copy[i]=table.clone(entry) end
    return copy
end
function Catalog.Income(collection)
    local income=0
    for _,entry in collection do income+=entry.Count*Catalog.ToyIncome(entry.Toy,entry.SizeMultiplier) end
    return income
end
return Catalog
</ProtectedString>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX1081">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="ModuleScript" referent="RBX1085">
      <Properties>
        <string name="Name">ToyGame</string>
        <ProtectedString name="Source">local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Catalog=require(ReplicatedStorage.ToyCatalog)
local Keeper=require(script.Parent.ToyKeeper)
local Game={}
Game.__index=Game
local LIMIT=9007199254740991
local function rootOf(player)
    local char=player.Character
    local h=char and char:FindFirstChildOfClass("Humanoid")
    return h and h.Health&gt;0 and char:FindFirstChild("HumanoidRootPart") or nil
end
local function inside(part,pos)
    local p=part.CFrame:PointToObjectSpace(pos)
    return math.abs(p.X)&lt;=part.Size.X/2 and math.abs(p.Y)&lt;=part.Size.Y/2 and math.abs(p.Z)&lt;=part.Size.Z/2
end
function Game.new(scene,progress,signal)
    local self=setmetatable({scene=scene,progress=progress,signal=signal,rng=Random.new(),
        slots={},carried={},plots={},cooldowns={},recovering={},selected={},customDisplay={},syncAt={},keepers={},lastIncome=workspace:GetServerTimeNow()},Game)
    for index,settings in Catalog.Zones do
        self.keepers[index]=Keeper.new(scene,scene.Keepers[settings.Keeper],scene.PatrolPoints[settings.Keeper],settings,
            function(p,keeper) self:Catch(p,keeper) end,function(pos) return inside(scene.SafeZone,pos) end,
            function(p,reason,name)
                if reason=="Safe" then self:EndChases(p) end
                self:Notify(p,reason=="Safe" and "СПАСЁН! Хранитель остался за границей сада." or name.." устал и вернулся к охране.")
                if reason=="Safe" then self.signal:FireClient(p,"Escaped") end
            end)
    end
    for _,point in scene.GiftPoints:GetChildren() do
        local slot={point=point,readyAt=0}
        table.insert(self.slots,slot);self:SpawnGift(slot)
    end
    for _,plot in scene.Bases:GetChildren() do
        plot.OpenStation.Prompt.Triggered:Connect(function(p) self:TryOpen(p) end)
        plot.SpeedStation.Prompt.Triggered:Connect(function(p) self:TryBuy(p) end)
        plot.BootsStation.Prompt.Triggered:Connect(function(p) self:TryBuy(p,"Boots") end)
    end
    signal.OnServerEvent:Connect(function(player,action,argument)
        -- Remote requests never carry rarity, award identity, balance or price.
        if action=="Open" then self:TryOpen(player)
        elseif action=="Speed" then self:TryBuy(player)
        elseif action=="Boots" then self:TryBuy(player,"Boots")
        elseif action=="Drop" then self:Drop(player)
        elseif action=="Select" then self:SelectToy(player,argument)
        elseif action=="Sync" and self.progress:IsReady(player) then
            local now=workspace:GetServerTimeNow()
            if now&gt;=(self.syncAt[player] or 0) then
                self.syncAt[player]=now+1
                for owner in self.plots do self:BroadcastCollection(owner,player) end
            end
        end
    end)
    return self
end
function Game:Notify(player,text)
    self.signal:FireClient(player,"Notify",text)
end
function Game:EndChases(player,reason)
    for _,keeper in self.keepers do keeper:RemovePlayer(player,reason) end
    self:UpdateChase(player)
end
function Game:UpdateChase(player)
    local deadline=0
    local name=""
    local count=0
    for _,keeper in self.keepers do
        local pursuit=keeper.pursuits[player]
        if pursuit then
            count+=1
            if pursuit.endsAt&gt;deadline then deadline=pursuit.endsAt;name=keeper.settings.GuardName end
        end
    end
    player:SetAttribute("ChaseEndsAt",deadline)
    player:SetAttribute("ChaseGuard",count&gt;1 and name.." +"..(count-1) or name)
end
function Game:BroadcastCollection(player,recipient)
    local collection=self.progress:GetCollection(player)
    if not collection then return end
    if not self.customDisplay[player] then
        local sorted=Catalog.CopyCollection(collection)
        table.sort(sorted,function(a,b)
            local aScore=table.find(Catalog.Order,Catalog.Toys[a.Toy].Rarity)*100+a.SizeMultiplier
            local bScore=table.find(Catalog.Order,Catalog.Toys[b.Toy].Rarity)*100+b.SizeMultiplier
            if aScore==bScore then return a.Toy&lt;b.Toy end
            return aScore&gt;bScore
        end)
        self.selected[player]={}
        for i=1,math.min(Catalog.VisibleToys,#sorted) do
            table.insert(self.selected[player],Catalog.Key(sorted[i].Toy,sorted[i].SizeMultiplier))
        end
    end
    local packet={UserId=player.UserId,BaseId=self.plots[player].Name,Entries=Catalog.CopyCollection(collection),Selected=table.clone(self.selected[player])}
    if recipient then self.signal:FireClient(recipient,"Collection",packet)
    else self.signal:FireAllClients("Collection",packet) end
end
function Game:SelectToy(player,key)
    if type(key)~="string" or #key&gt;80 or not self.progress:IsReady(player) or not self:TakeAction(player) then return false end
    local owned=false
    for _,entry in self.progress:GetCollection(player) do if Catalog.Key(entry.Toy,entry.SizeMultiplier)==key then owned=true;break end end
    if not owned then return false end
    local selected=self.selected[player]
    local index=table.find(selected,key)
    if index then table.remove(selected,index)
    elseif #selected&lt;Catalog.VisibleToys then table.insert(selected,key)
    else self:Notify(player,"В саду четыре игрушки. Сначала убери одну из прогулки.");return false end
    self.customDisplay[player]=true;self:BroadcastCollection(player)
    return true
end
function Game:InOwnBase(player)
    local root=rootOf(player)
    local plot=self.plots[player]
    return root and plot and inside(plot.Area,root.Position)
end
function Game:CanUse(player,station)
    if not self.progress:IsReady(player) then return false end
    local root=rootOf(player)
    if not root or (root.Position-station.Position).Magnitude&gt;13*Catalog.WorldScale then return false end
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances={player.Character,self.scene.Gifts}
    params.RespectCanCollide=true
    local hit=workspace:Raycast(root.Position,station.Position-root.Position,params)
    return not hit or hit.Instance==station
end
function Game:TakeAction(player)
    local now=workspace:GetServerTimeNow()
    if now&lt;(self.cooldowns[player] or 0) then return false end
    self.cooldowns[player]=now+.35
    return true
end
function Game:SpawnGift(slot)
    local zone=tonumber(slot.point.Name:match("^Z(%d)"))
    local rarity=Catalog.RollGift(zone,self.rng,slot.point.Name:find("Upper")~=nil)
    local model=ReplicatedStorage.GiftModels[rarity]:Clone()
    model.Name=slot.point.Name
    model:SetAttribute("Rarity",rarity);model:SetAttribute("Zone",zone)
    model:PivotTo(slot.point.CFrame*CFrame.new(0,1.45*Catalog.WorldScale,0))
    model.Parent=self.scene.Gifts
    slot.model=model;slot.rarity=rarity;slot.zone=zone;slot.owner=nil;slot.readyAt=nil
    model.Box.Prompt.Triggered:Connect(function(p) self:TryPickup(p,slot) end)
end
function Game:TryPickup(player,slot)
    if slot.owner or not slot.model or not slot.model.Box.Prompt.Enabled or self.carried[player]
        or not self.progress:IsReady(player) or player:GetAttribute("PendingGift")~="" then return false end
    local now=workspace:GetServerTimeNow()
    if now&lt;(player:GetAttribute("CatchGraceUntil") or 0) then return false end
    if not self:CanUse(player,slot.model.Box) or not self:TakeAction(player) then return false end
    local root=rootOf(player)
    slot.owner=player;self.carried[player]=slot
    slot.model.Box.Prompt.Enabled=false
    slot.model:PivotTo(root.CFrame*CFrame.new(0,.5,-2.3*Catalog.WorldScale))
    for _,part in slot.model:GetDescendants() do if part:IsA("BasePart") then part.Anchored=false end end
    local weld=Instance.new("WeldConstraint")
    weld.Name="CarryWeld";weld.Part0=root;weld.Part1=slot.model.Box;weld.Parent=slot.model.Box
    player:SetAttribute("CarriedGift",slot.rarity)
    local index=table.find(Catalog.Order,slot.rarity)
    self.keepers[slot.zone]:StartChase(player,index)
    self:UpdateChase(player)
    self:Notify(player,Catalog.Zones[slot.zone].GuardName.." заметил кражу! Беги в свой сад.")
    return true
end
function Game:Detach(slot)
    local weld=slot.model.Box:FindFirstChild("CarryWeld")
    if weld then weld:Destroy() end
    for _,part in slot.model:GetDescendants() do if part:IsA("BasePart") then part.Anchored=true end end
    local player=slot.owner
    if player then self.carried[player]=nil;player:SetAttribute("CarriedGift","") end
    slot.owner=nil
end
function Game:DropPosition(root)
    local rays=RaycastParams.new()
    rays.FilterType=Enum.RaycastFilterType.Include
    rays.FilterDescendantsInstances={self.scene.Geometry,self.scene.Bases}
    rays.RespectCanCollide=true
    local overlap=OverlapParams.new()
    overlap.FilterType=Enum.RaycastFilterType.Include
    overlap.FilterDescendantsInstances=rays.FilterDescendantsInstances
    overlap.RespectCanCollide=true
    for _,offset in {root.CFrame.LookVector*4*Catalog.WorldScale,Vector3.zero,root.CFrame.RightVector*4*Catalog.WorldScale,-root.CFrame.RightVector*4*Catalog.WorldScale,-root.CFrame.LookVector*4*Catalog.WorldScale} do
        local wall=offset.Magnitude&gt;0 and workspace:Raycast(root.Position,offset,rays)
        local candidate=wall and wall.Position+wall.Normal*1.8*Catalog.WorldScale or root.Position+offset
        local ground=workspace:Raycast(candidate+Vector3.new(0,2,0),Vector3.new(0,-48,0),rays)
        if ground and ground.Normal.Y&gt;.8 then
            local position=ground.Position+Vector3.new(0,1.45*Catalog.WorldScale,0)
            if #workspace:GetPartBoundsInBox(CFrame.new(position+Vector3.new(0,.35*Catalog.WorldScale,0)),Vector3.new(2.8,3.2,2.8)*Catalog.WorldScale,overlap)==0 then
                return position
            end
        end
    end
    return nil
end
function Game:Drop(player,forced)
    local slot=self.carried[player]
    if not slot then return false end
    if not forced and (not self.progress:IsReady(player) or not self:TakeAction(player)) then return false end
    local root=rootOf(player)
    local position=root and self:DropPosition(root)
    if not position and not forced then self:Notify(player,"Здесь тесно. Отойди от мебели, чтобы бросить подарок.");return false end
    -- Death in the void or a fully occupied corner must not strand a shared gift.
    position=position or slot.point.Position+Vector3.new(0,1.45*Catalog.WorldScale,0)
    self:Detach(slot)
    slot.model:PivotTo(CFrame.new(position))
    slot.model.Box.Prompt.Enabled=true
    return true
end
-- Choose a clear physical arc before applying the impulse. Furniture is checked along
-- the whole flight, not just at its destination; there is no character teleport.
function Game:ThrowVelocity(root,keeper)
    local config=Catalog.Catch
    local away=root.Position-keeper.root.Position
    away=Vector3.new(away.X,0,away.Z)
    away=away.Magnitude&gt;.1 and away.Unit or -keeper.root.CFrame.LookVector
    local rays=RaycastParams.new();rays.FilterType=Enum.RaycastFilterType.Include
    rays.FilterDescendantsInstances={self.scene.Geometry,self.scene.Bases};rays.RespectCanCollide=true
    local best,bestDistance
    for _,power in {1,.72,.45} do
        for _,angle in {0,math.pi/4,-math.pi/4,math.pi/2,-math.pi/2,math.pi} do
            local direction=CFrame.Angles(0,angle,0):VectorToWorldSpace(away)
            local velocity=direction*config.HorizontalSpeed*power+Vector3.new(0,config.VerticalSpeed*power,0)
            local previous=root.Position
            local clear=true
            local flight=2*velocity.Y/workspace.Gravity
            for step=1,12 do
                local t=flight*step/12
                local position=root.Position+velocity*t-Vector3.new(0,workspace.Gravity*t*t/2,0)
                if workspace:Spherecast(previous,2,position-previous,rays) then clear=false;break end
                previous=position
            end
            local floor=clear and workspace:Raycast(previous+Vector3.new(0,2,0),Vector3.new(0,-12,0),rays)
            local distance=(previous-root.Position).Magnitude
            if floor and floor.Normal.Y&gt;.8 and (not bestDistance or distance&gt;bestDistance) then
                best=velocity;bestDistance=distance
            end
        end
        if best then return best end
    end
    -- A crowded corner gets a small upward physical shove until a full arc is free.
    return Vector3.new(0,config.VerticalSpeed*.45,0)
end
function Game:FinishRecovery(player)
    local recovery=self.recovering[player]
    if not recovery then return end
    self.recovering[player]=nil
    local humanoid=recovery.humanoid
    if humanoid.Parent then
        humanoid.PlatformStand=false;humanoid.AutoRotate=true
        if humanoid.Health&gt;0 then humanoid:ChangeState(Enum.HumanoidStateType.GettingUp) end
    end
    if recovery.root.Parent then
        recovery.root.AssemblyAngularVelocity=Vector3.zero
        recovery.root:SetNetworkOwnershipAuto()
    end
    self:ApplyMovement(player)
end
function Game:Catch(player,keeper)
    local now=workspace:GetServerTimeNow()
    local root=rootOf(player)
    if not root or not self.progress:IsReady(player) or self.recovering[player]
        or now&lt;(player:GetAttribute("CatchGraceUntil") or 0) or inside(self.scene.SafeZone,root.Position) then return false end
    local velocity=self:ThrowVelocity(root,keeper)
    self:Drop(player,true)
    player:SetAttribute("CatchGraceUntil",now+Catalog.Catch.GraceSeconds)
    local humanoid=root.Parent:FindFirstChildOfClass("Humanoid")
    self.recovering[player]={root=root,humanoid=humanoid,started=now}
    humanoid.WalkSpeed=0;humanoid.PlatformStand=true;humanoid.AutoRotate=false
    root:SetNetworkOwner(nil)
    root:ApplyImpulse(root.AssemblyMass*(velocity-root.AssemblyLinearVelocity))
    root.AssemblyAngularVelocity=Vector3.new(Catalog.Catch.Spin,.8,0)
    self.signal:FireClient(player,"Caught",root.Position)
    self:Notify(player,"УХ! Подарок рядом с охранником — успей вернуть его!")
    return true
end
function Game:StepRecovery(player,now)
    local recovery=self.recovering[player]
    if not recovery then return end
    local root=recovery.root
    if not root.Parent or recovery.humanoid.Health&lt;=0 or player.Character~=root.Parent then self:FinishRecovery(player);return end
    local v=root.AssemblyLinearVelocity
    local flat=Vector3.new(v.X,0,v.Z)
    local config=Catalog.Catch
    if flat.Magnitude&gt;config.MaxHorizontalSpeed then flat=flat.Unit*config.MaxHorizontalSpeed end
    root.AssemblyLinearVelocity=flat+Vector3.new(0,math.clamp(v.Y,-config.MaxFallSpeed,config.MaxVerticalSpeed),0)
    local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Include
    params.FilterDescendantsInstances={self.scene.Geometry,self.scene.Bases};params.RespectCanCollide=true
    local ground=workspace:Raycast(root.Position,Vector3.new(0,-3.8,0),params)
    if now-recovery.started&gt;.25 and v.Y&lt;=2 and ground then
        recovery.landedAt=recovery.landedAt or now
    end
    if (recovery.landedAt and now&gt;=recovery.landedAt+config.LandingDelay) or now-recovery.started&gt;=config.MaxFlightSeconds then self:FinishRecovery(player) end
end
function Game:Deliver(player)
    local slot=self.carried[player]
    if not slot or not self.progress:IsReady(player) or not self:InOwnBase(player) then return false end
    if player:GetAttribute("PendingGift")~="" then return false end
    -- Commit the delivered identity first; there is no yield or second carried balance.
    player:SetAttribute("PendingGift",slot.rarity)
    self:Detach(slot);slot.model:Destroy();slot.model=nil
    slot.readyAt=workspace:GetServerTimeNow()+Catalog.GiftRespawnSeconds
    self:EndChases(player,"Safe")
    self.progress:RequestSave(player)
    self:Notify(player,"Доставлено! Подойди к столу «ОТКРЫТЬ» в своём саду.")
    return true
end
function Game:TryOpen(player)
    local plot=self.plots[player]
    if not plot or not self:InOwnBase(player) or not self:CanUse(player,plot.OpenStation) then return false end
    local rarity=player:GetAttribute("PendingGift")
    if not Catalog.Gifts[rarity] or not self:TakeAction(player) then return false end
    local id=Catalog.Roll(Catalog.Gifts[rarity].Contents,self.rng)
    local size=Catalog.RollSize(self.rng)
    local collection=self.progress:GetCollection(player)
    local existing
    for _,entry in collection do if entry.Toy==id and entry.SizeMultiplier==size then existing=entry;break end end
    if existing and existing.Count&gt;=LIMIT then return false end
    -- Award before visual feedback; repeat, death and disconnect cannot duplicate the opening.
    player:SetAttribute("PendingGift","")
    if existing then existing.Count+=1 else table.insert(collection,{Toy=id,SizeMultiplier=size,Count=1}) end
    player:SetAttribute("Income",Catalog.Income(collection))
    self.progress:RequestSave(player)
    self:BroadcastCollection(player)
    self.signal:FireClient(player,"Opened",{Toy=id,Gift=rarity,SizeMultiplier=size,Income=Catalog.ToyIncome(id,size)})
    return true,id
end
function Game:TryBuy(player,kind)
    local plot=self.plots[player]
    if kind~=nil and kind~="Boots" then return false end
    if not plot or not self:InOwnBase(player) or not self:CanUse(player,kind=="Boots" and plot.BootsStation or plot.SpeedStation) or not self:TakeAction(player) then return false end
    local level=player:GetAttribute("SpeedLevel")
    if kind=="Boots" and player:GetAttribute("BootsUnlocked") then return false end
    local price=kind=="Boots" and Catalog.Boots.Price or Catalog.SpeedPrices[level+1]
    if not price then return false end
    local coins=player:GetAttribute("Coins")
    if coins&lt;price then self:Notify(player,"Нужно "..price.." монет. Игрушки приносят доход каждую секунду.");return false end
    player:SetAttribute("Coins",coins-price)
    if kind=="Boots" then player:SetAttribute("BootsUnlocked",true) else player:SetAttribute("SpeedLevel",level+1) end
    self:ApplyMovement(player);self.progress:RequestSave(player)
    self:Notify(player,kind=="Boots" and "Пружинные ботинки! Прыгай обычной кнопкой на высокие площадки." or "Скорость "..Catalog.Speed[level+2].."! Дальние подарки стали ближе.")
    return true
end
function Game:ApplyMovement(player)
    local root=rootOf(player)
    if root then
        local character=root.Parent
        local humanoid=character:FindFirstChildOfClass("Humanoid")
        humanoid.WalkSpeed=self.recovering[player] and 0 or Catalog.Speed[player:GetAttribute("SpeedLevel")+1]
        humanoid.UseJumpPower=false
        humanoid.JumpHeight=(player:GetAttribute("BootsUnlocked") and Catalog.Boots.JumpHeight or Catalog.Boots.NormalJumpHeight)*Catalog.WorldScale
        if player:GetAttribute("BootsUnlocked") and not character:FindFirstChild("SpringBoots") then
            local boots=Instance.new("Folder");boots.Name="SpringBoots";boots.Parent=character
            for _,side in {"Left","Right"} do
                local foot=character:FindFirstChild(side.."Foot") or character:FindFirstChild(side.." Leg")
                if foot then
                    local boot=ReplicatedStorage.SpringBoot:Clone();boot.Name=side
                    boot:PivotTo(foot.CFrame*CFrame.new(0,-foot.Size.Y/2,0));boot.Parent=boots
                    for _,part in boot:GetDescendants() do if part:IsA("BasePart") then part.Anchored=false end end
                    local weld=Instance.new("WeldConstraint");weld.Part0=foot;weld.Part1=boot.PrimaryPart;weld.Parent=boot.PrimaryPart
                end
            end
        end
    end
end
function Game:AddPlayer(player,data)
    local used={}
    for _,plot in self.plots do used[plot]=true end
    local plots=self.scene.Bases:GetChildren()
    table.sort(plots,function(a,b) return a.Name&lt;b.Name end)
    local plot
    for _,candidate in plots do if not used[candidate] then plot=candidate;break end end
    if not plot then return false end
    self.plots[player]=plot
    plot:SetAttribute("OwnerUserId",player.UserId)
    plot.Sign.SurfaceGui.Label.Text=player.DisplayName.."\nЖИВОЙ САД"
    player.RespawnLocation=plot.Spawn
    player:SetAttribute("BaseId",plot.Name)
    player:SetAttribute("Coins",data.Coins);player:SetAttribute("SpeedLevel",data.SpeedLevel)
    player:SetAttribute("BootsUnlocked",data.BootsUnlocked)
    player:SetAttribute("PendingGift",data.PendingGift);player:SetAttribute("CarriedGift","")
    player:SetAttribute("ChaseEndsAt",0);player:SetAttribute("CatchGraceUntil",0)
    if not self.progress:Activate(player) then self:RemovePlayer(player);return false end
    player:SetAttribute("Income",Catalog.Income(self.progress:GetCollection(player)))
    self.selected[player]={};self:BroadcastCollection(player)
    return true
end
function Game:CharacterAdded(player,character)
    local root=character:WaitForChild("HumanoidRootPart",10)
    local humanoid=character:WaitForChild("Humanoid",10)
    if not root or not humanoid or player.Character~=character then return end
    local plot=self.plots[player]
    if plot then character:PivotTo(plot.Spawn.CFrame*CFrame.new(0,4,0)) end
    self:ApplyMovement(player)
    humanoid.Died:Connect(function()
        self:Drop(player,true);self:EndChases(player);self:FinishRecovery(player)
    end)
end
function Game:RemovePlayer(player)
    self:Drop(player,true);self:EndChases(player);self:FinishRecovery(player)
    local plot=self.plots[player]
    if plot then plot:SetAttribute("OwnerUserId",nil);plot.Sign.SurfaceGui.Label.Text="СВОБОДНЫЙ\nЖИВОЙ САД" end
    self.plots[player]=nil;self.cooldowns[player]=nil;self.recovering[player]=nil
    self.selected[player]=nil;self.customDisplay[player]=nil;self.syncAt[player]=nil
    self.signal:FireAllClients("CollectionRemoved",player.UserId)
end
function Game:Step(now)
    for player in self.plots do
        local root=rootOf(player)
        player:SetAttribute("AtBase",root~=nil and self:InOwnBase(player)==true)
        if root and self.carried[player] then self:Deliver(player) end
        self:StepRecovery(player,now)
    end
    local seconds=math.floor(now-self.lastIncome)
    if seconds&gt;=1 then
        self.lastIncome+=seconds
        for player in self.plots do
            if self.progress:IsReady(player) then
                local income=player:GetAttribute("Income")
                player:SetAttribute("Coins",math.min(LIMIT,player:GetAttribute("Coins")+income*seconds))
            end
        end
    end
    for _,slot in self.slots do if not slot.model and now&gt;=(slot.readyAt or math.huge) then self:SpawnGift(slot) end end
    for _,keeper in self.keepers do keeper:Step(now) end
    for player in self.plots do self:UpdateChase(player) end
end
return Game
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX1086">
      <Properties>
        <string name="Name">ToyKeeper</string>
        <ProtectedString name="Source">local Players=game:GetService("Players")
local PathfindingService=game:GetService("PathfindingService")
local Catalog=require(game:GetService("ReplicatedStorage").ToyCatalog)
local Keeper={}
Keeper.__index=Keeper
local function horizontal(v) return Vector3.new(v.X,0,v.Z) end
function Keeper.new(scene,model,points,settings,onCaught,inBase,onEscape)
    settings=table.clone(settings)
    settings.AgentRadius*=Catalog.WorldScale;settings.AgentHeight*=Catalog.WorldScale
    local self=setmetatable({scene=scene,model=model,root=model.HumanoidRootPart,humanoid=model.Humanoid,
        settings=settings,onCaught=onCaught,inBase=inBase,onEscape=onEscape,pursuits={},version=0,
        lastPath=-100,patrolIndex=1,joints={},switchAt=0},Keeper)
    self.points=points:GetChildren()
    table.sort(self.points,function(a,b) return a.Name&lt;b.Name end)
    self.boundaryZ=scene.SafeZone.Position.Z+scene.SafeZone.Size.Z/2+settings.AgentRadius+2
    for _,v in model:GetDescendants() do
        if v:IsA("BasePart") and not v.Anchored then v:SetNetworkOwner(nil) end
        if v:IsA("Motor6D") then self.joints[v.Name]={joint=v,base=v.C0} end
    end
    self:SetState("Guarding")
    return self
end
function Keeper:ResetPath()
    self.version+=1;self.waypoints=nil;self.index=2;self.lastPath=-100
end
function Keeper:SetState(state)
    self.state=state;self.model:SetAttribute("State",state);self:ResetPath()
    local chasing=state=="Chasing" or state=="Striking"
    self.model.EyeL.Color=chasing and Color3.fromRGB(255,90,78) or Color3.fromRGB(132,237,255)
    self.model.EyeR.Color=self.model.EyeL.Color
    self.root.Mood.Label.Text=self.settings.GuardName.."\n"..(chasing and "ВЕРНИ ПОДАРОК!" or state=="Returning" and "Назад к игрушкам…" or "Можно смотреть. Не трогать!")
end
function Keeper:Root(player)
    local char=player.Character
    local h=char and char:FindFirstChildOfClass("Humanoid")
    if player.Parent~=Players or not player:GetAttribute("ProgressLoaded") or not h or h.Health&lt;=0 then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end
function Keeper:Visible(root)
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances={self.scene.Keepers,self.scene.Gifts,self.scene.GiftPoints}
    params.RespectCanCollide=true
    local origin=(self.model.EyeL.Position+self.model.EyeR.Position)/2
    local hit=workspace:Raycast(origin,root.Position-origin,params)
    return not hit or hit.Instance:IsDescendantOf(root.Parent)
end
function Keeper:StartChase(player,rarityIndex)
    local now=workspace:GetServerTimeNow()
    local root=self:Root(player)
    if not root or now&lt;(player:GetAttribute("CatchGraceUntil") or 0) then return false end
    if self.pursuits[player] then return true end
    local settings=self.settings
    self.pursuits[player]={endsAt=now+settings.ChaseSeconds,warningUntil=now+settings.Warning,
        lastKnown=root.Position,speed=settings.ChaseSpeed+(rarityIndex-1)*.2,started=now}
    if not self.target then self.target=player;self.switchAt=now+1.5;self:SetState("Chasing") end
    return true
end
function Keeper:RemovePlayer(player,reason)
    if not self.pursuits[player] then return end
    self.pursuits[player]=nil
    if self.target==player then
        self.target=nil;self.model:SetAttribute("TargetUserId",0)
        self.humanoid:MoveTo(self.root.Position)
        self:SetState("Returning")
    end
    if reason then self.onEscape(player,reason,self.settings.GuardName) end
end
function Keeper:Navigate(goal,now)
    goal=Vector3.new(goal.X,goal.Y,math.max(self.boundaryZ,goal.Z))
    local delta=goal-self.root.Position
    if horizontal(delta).Magnitude&lt;2.5 and math.abs(delta.Y)&lt;8 then self.humanoid:MoveTo(self.root.Position);return end
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Include
    params.FilterDescendantsInstances={self.scene.Geometry,self.scene.Bases}
    params.RespectCanCollide=true
    local size=Vector3.new(self.settings.AgentRadius*2,5,self.settings.AgentRadius*1.5)
    if math.abs(delta.Y)&lt;3 and not workspace:Blockcast(self.root.CFrame,size,horizontal(delta),params) then
        self.humanoid:MoveTo(goal);return
    end
    if not self.computing and now-self.lastPath&gt;self.settings.Repath then
        self.lastPath=now;self.computing=true
        local version=self.version
        local function ground(position)
            local hit=workspace:Raycast(position+Vector3.new(0,2,0),Vector3.new(0,-50,0),params)
            return hit and hit.Position+Vector3.new(0,.5,0) or position
        end
        local origin=ground(self.root.Position)
        local destination=ground(goal)
        task.spawn(function()
            local path=PathfindingService:CreatePath({AgentRadius=self.settings.AgentRadius,AgentHeight=self.settings.AgentHeight,
                AgentCanJump=false,WaypointSpacing=4,Costs={SafeBase=math.huge}})
            local ok=pcall(function() path:ComputeAsync(origin,destination) end)
            self.computing=false
            if version~=self.version then return end
            if ok and path.Status==Enum.PathStatus.Success then self.waypoints=path:GetWaypoints();self.index=2 end
        end)
    end
    local waypoint=self.waypoints and self.waypoints[self.index]
    if waypoint then
        local p=waypoint.Position
        local destination=Vector3.new(p.X,p.Y,math.max(self.boundaryZ,p.Z))
        local distance=destination-self.root.Position
        if horizontal(distance).Magnitude&lt;3 and math.abs(distance.Y)&lt;self.settings.AgentHeight then
            self.index+=1;waypoint=self.waypoints[self.index]
        end
        if waypoint then
            local p=waypoint.Position
            self.humanoid:MoveTo(Vector3.new(p.X,p.Y,math.max(self.boundaryZ,p.Z)))
        end
    else self.humanoid:MoveTo(self.root.Position) end
end
function Keeper:Step(now)
    local best,bestScore
    for player,pursuit in self.pursuits do
        local root=self:Root(player)
        if not root or now&gt;=pursuit.endsAt then self:RemovePlayer(player,root and "Tired" or nil)
        elseif self.inBase(root.Position) then self:RemovePlayer(player,"Safe")
        else
            pursuit.visible=self:Visible(root)
            if pursuit.visible then pursuit.lastKnown=root.Position end
            local score=(pursuit.lastKnown-self.root.Position).Magnitude+(pursuit.visible and 0 or 200)
            if not bestScore or score&lt;bestScore then best=player;bestScore=score end
        end
    end
    if best and (not self.target or (now&gt;=self.switchAt and best~=self.target)) then
        self.target=best;self.switchAt=now+1.5;self:SetState("Chasing")
    end
    local goal
    local pursuit=self.target and self.pursuits[self.target]
    if pursuit then
        self.model:SetAttribute("TargetUserId",self.target.UserId)
        self.humanoid.WalkSpeed=now&lt;pursuit.warningUntil and 0 or pursuit.speed
        goal=pursuit.lastKnown
        local root=self:Root(self.target)
        if now&gt;=pursuit.warningUntil and pursuit.visible and root
            and horizontal(root.Position-self.root.Position).Magnitude&lt;self.settings.AgentRadius+1.8
            and math.abs(root.Position.Y-self.root.Position.Y)&lt;self.settings.AgentHeight*.6 then
            if not self.strike and now&gt;=(self.target:GetAttribute("CatchGraceUntil") or 0) then
                self.strike={player=self.target,hitAt=now+Catalog.Catch.Windup,
                    endsAt=now+Catalog.Catch.Windup+Catalog.Catch.FollowThrough}
                self:SetState("Striking")
            end
        end
    else
        self.humanoid.WalkSpeed=self.settings.PatrolSpeed
        local point=self.points[self.patrolIndex]
        if horizontal(self.root.Position-point.Position).Magnitude&lt;5 then
            self.patrolIndex=self.patrolIndex%#self.points+1
            self:ResetPath()
            if self.state=="Returning" then self:SetState("Guarding") end
        end
        goal=self.points[self.patrolIndex].Position
    end
    local strike=self.strike
    if strike then
        goal=nil;self.humanoid.WalkSpeed=0;self.humanoid:MoveTo(self.root.Position)
        if not strike.hit and now&gt;=strike.hitAt then
            strike.hit=true
            local victim=self:Root(strike.player)
            if victim and self.pursuits[strike.player] and self:Visible(victim)
                and horizontal(victim.Position-self.root.Position).Magnitude&lt;self.settings.AgentRadius+5
                and math.abs(victim.Position.Y-self.root.Position.Y)&lt;self.settings.AgentHeight*.6
                and not self.inBase(victim.Position) then self.onCaught(strike.player,self) end
        end
        if now&gt;=strike.endsAt then self.strike=nil;self:SetState(self.target and "Chasing" or "Returning") end
    elseif goal then self:Navigate(goal,now) end
    local moving=horizontal(self.root.AssemblyLinearVelocity).Magnitude&gt;1
    local kind=self.settings.Keeper
    for name,data in self.joints do
        local phase=now*self.settings.Motion
        local swing=moving and math.sin(phase)*.3 or math.sin(now*1.5)*.025
        local yaw,roll=0,0
        if kind=="Plush" then
            swing*=1.6;roll=math.sin(phase)*.09
            if name=="RootJoint" then swing=0;roll=moving and math.sin(phase)*.09 or 0 end
        elseif kind=="Clockwork" then
            swing=moving and math.floor(math.sin(phase)*3)/3*.5 or 0
            yaw=math.sin(now*3)&gt;.8 and .12 or 0
            roll=math.sin(phase*2)*.045
        else
            swing*=1.3
            if name:find("Shoulder") then swing=-.55+math.sin(phase)*.22;roll=.13 end
            if name=="RootJoint" then swing=moving and -.18 or -.06 end
        end
        if name=="Left Hip" or name=="Right Shoulder" then swing=-swing end
        if name=="Neck" then swing=math.sin(now*(kind=="Clockwork" and 5 or 1.8))*.08 end
        if self.strike then
            local stage=now&lt;self.strike.hitAt and -1 or 1
            if name:find("Shoulder") then swing=stage*1.35;roll=0
            elseif name=="RootJoint" then swing=stage*.2 end
        end
        data.joint.C0=data.base*CFrame.Angles(swing,yaw,roll)
    end
end
return Keeper
</ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="RBX1087">
      <Properties>
        <string name="Name">ToyProgress</string>
        <ProtectedString name="Source">local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Catalog = require(game:GetService("ReplicatedStorage").ToyCatalog)
local PlayerProgress = {}
PlayerProgress.__index = PlayerProgress

local LEASE_SECONDS = 180
local AUTOSAVE_SECONDS = 45
local LEASE_MARGIN = 15
local REQUEST_SECONDS = 20
local MAX_ATTEMPTS = 4
local WRITE_INTERVAL = 5
local MAX_INTEGER = 9007199254740991
local STORE_NAME = RunService:IsStudio() and "ToyKeeperProgress_Studio_v1" or "ToyKeeperProgress_v1"

local function integer(value)
    return type(value)=="number" and value&gt;=0 and value&lt;=MAX_INTEGER and value%1==0
end

local function validValues(record)
    if type(record)~="table" or not integer(record.Coins) or not integer(record.SpeedLevel)
        or record.SpeedLevel&gt;5 or type(record.BootsUnlocked)~="boolean" or type(record.Collection)~="table"
        or type(record.PendingGift)~="string" or (record.PendingGift~="" and not Catalog.Gifts[record.PendingGift]) then return false end
    local seen={}
    local length=0
    for index,entry in record.Collection do
        if not integer(index) or index&lt;1 or type(entry)~="table" or not Catalog.Toys[entry.Toy]
            or not Catalog.Size(entry.SizeMultiplier) or not integer(entry.Count) or entry.Count&lt;1 then return false end
        local key=Catalog.Key(entry.Toy,entry.SizeMultiplier)
        if seen[key] then return false end
        seen[key]=true;length+=1
    end
    return length==#record.Collection and length&lt;=#Catalog.ToyOrder*#Catalog.Sizes
end
local function validLegacy(record)
    if not integer(record.Coins) or not integer(record.SpeedLevel) or record.SpeedLevel&gt;5 or type(record.Toys)~="table"
        or type(record.PendingGift)~="string" or (record.PendingGift~="" and not Catalog.Gifts[record.PendingGift]) then return false end
    for id,count in record.Toys do if not table.find(Catalog.LegacyToyOrder,id) or not integer(count) then return false end end
    for _,id in Catalog.LegacyToyOrder do if not integer(record.Toys[id]) then return false end end
    return true
end
local function valid(record)
    if type(record)~="table" then return false end
    if record.Version==1 then if not validLegacy(record) then return false end
    elseif record.Version==2 then if not validValues(record) then return false end
    else return false end
    local session=record.Session
    return session==nil or (type(session)=="table" and type(session.Token)=="string" and integer(session.ExpiresAt))
end
local function snapshot(profile)
    local player=profile.player
    return {Coins=player:GetAttribute("Coins"),SpeedLevel=player:GetAttribute("SpeedLevel"),
        BootsUnlocked=player:GetAttribute("BootsUnlocked"),Collection=Catalog.CopyCollection(profile.collection),PendingGift=player:GetAttribute("PendingGift")}
end

-- A single store dependency keeps the session protocol testable without live cloud writes.
function PlayerProgress.new(store,budgetAvailable)
    return setmetatable({store=store,budgetAvailable=budgetAvailable,profiles={},rng=Random.new()},PlayerProgress)
end

local function pause(seconds,deadline)
    local untilTime=math.min(os.clock()+seconds,deadline)
    while os.clock()&lt;untilTime do task.wait(math.min(.25,untilTime-os.clock())) end
end

function PlayerProgress:_request(profile,transform,deadline)
    local lastError="timeout"
    for attempt=1,MAX_ATTEMPTS do
        while os.clock()&lt;deadline and not self.budgetAvailable() do task.wait(.25) end
        if os.clock()&gt;=deadline then return nil,lastError end
        local rejected
        local ok,result=pcall(function()
            return self.store:UpdateAsync("Player_"..profile.player.UserId,function(old,info)
                -- Roblox may invoke this callback repeatedly after a conflicting write.
                rejected=nil
                if os.clock()&gt;=deadline then rejected="timeout";return nil end
                local value,reason=transform(old)
                if not value then rejected=reason;return nil end
                return value,profile.player.UserId&gt;0 and {profile.player.UserId} or {},info and info:GetMetadata() or {}
            end)
        end)
        if ok and result~=nil then return result end
        lastError=rejected or tostring(result)
        if rejected and rejected~="locked" then return nil,rejected end
        if attempt&lt;MAX_ATTEMPTS then pause(2^(attempt-1)+self.rng:NextNumber(0,.5),deadline) end
    end
    return nil,lastError
end

function PlayerProgress:Load(player)
    if self.shutdownDeadline then return nil,"server closing" end
    if self.profiles[player] then return nil,"already loading" end
    local profile={player=player,token=HttpService:GenerateGUID(false),loading=true,nextWrite=0}
    self.profiles[player]=profile
    local deadline=math.min(os.clock()+REQUEST_SECONDS,self.shutdownDeadline or math.huge)
    local data,reason=self:_request(profile,function(old)
        if profile.closing then return nil,"cancelled" end
        if old==nil then
            old={Version=2,Coins=0,SpeedLevel=0,BootsUnlocked=false,Collection={},PendingGift=""}
        end
        if not valid(old) then return nil,"invalid data or unsupported version" end
        local lock=old.Session
        if lock and lock.Token~=profile.token and lock.ExpiresAt&gt;os.time() then return nil,"locked" end
        local record=table.clone(old)
        -- Lossless migration only after session ownership is available, in the same UpdateAsync.
        if old.Version==1 then
            record.Version=2;record.BootsUnlocked=false;record.Collection={}
            for _,id in Catalog.LegacyToyOrder do
                if old.Toys[id]&gt;0 then table.insert(record.Collection,{Toy=id,SizeMultiplier=1,Count=old.Toys[id]}) end
            end
            record.Toys=nil
        end
        record.Session={Token=profile.token,ExpiresAt=os.time()+LEASE_SECONDS}
        return record
    end,deadline)
    profile.loading=false
    if not data then
        self.profiles[player]=nil
        warn("[PlayerProgress] Load failed for "..player.UserId..": "..reason)
        return nil,reason
    end
    profile.loaded=true;profile.expiresAt=data.Session.ExpiresAt
    profile.collection=Catalog.CopyCollection(data.Collection)
    profile.initial={Coins=data.Coins,SpeedLevel=data.SpeedLevel,BootsUnlocked=data.BootsUnlocked,Collection=profile.collection,PendingGift=data.PendingGift}
    if profile.closing or player.Parent~=Players then
        self:Close(player)
        return nil,"cancelled"
    end
    return table.clone(profile.initial)
end

-- ToyGame applies loaded attributes before activating gameplay access.
function PlayerProgress:Activate(player)
    local profile=self.profiles[player]
    if not profile or not profile.loaded or profile.closing or player.Parent~=Players then return false end
    profile.applied=true;profile.initial=nil
    profile.nextAutosave=os.clock()+self.rng:NextNumber(30,AUTOSAVE_SECONDS)
    player:SetAttribute("TemporaryProgress",self.temporary==true)
    player:SetAttribute("ProgressLoaded",true)
    return true
end

function PlayerProgress:IsReady(player)
    local profile=self.profiles[player]
    return profile~=nil and profile.applied==true and not profile.closing and not profile.lost
        and player.Parent==Players and os.time()&lt;profile.expiresAt-LEASE_MARGIN
end

-- One authoritative collection per active profile; ToyGame is the mutation owner.
function PlayerProgress:GetCollection(player)
    if not self:IsReady(player) then return nil end
    return self.profiles[player].collection
end

function PlayerProgress:_lose(profile,reason)
    profile.lost=true
    profile.player:SetAttribute("ProgressLoaded",false)
    warn("[PlayerProgress] Session stopped for "..profile.player.UserId..": "..reason)
    if profile.player.Parent==Players then
        profile.player:Kick("Соединение с сохранением потеряно. Зайдите снова через пару минут; сохранённый прогресс защищён.")
    end
end

function PlayerProgress:_write(profile,release,deadline)
    while (profile.loading or profile.busy) and os.clock()&lt;deadline do task.wait(.1) end
    if self.profiles[profile.player]~=profile then return true end
    if profile.loading or profile.busy or not profile.loaded or profile.lost or os.clock()&gt;=deadline then return false end
    if profile.closing and not release then return false end
    profile.busy=true
    local player=profile.player
    local data=profile.applied and snapshot(profile) or profile.initial
    local writeId=HttpService:GenerateGUID(false)
    local saved,reason=self:_request(profile,function(old)
        if not valid(old) or not validValues(data) then
            return nil,"invalid data or unsupported version"
        end
        -- A release may have committed even if the response was lost. Acknowledge without rewriting.
        if release and old.LastWrite==writeId then return old end
        local lock=old.Session
        if not lock or lock.Token~=profile.token or lock.ExpiresAt&lt;=os.time() then return nil,"session lost" end
        local record=table.clone(old)
        record.Version=2;record.Coins=data.Coins;record.SpeedLevel=data.SpeedLevel;record.LastWrite=writeId
        record.Collection=Catalog.CopyCollection(data.Collection);record.BootsUnlocked=data.BootsUnlocked;record.PendingGift=data.PendingGift
        record.Toys=nil
        record.Session=not release and {Token=profile.token,ExpiresAt=os.time()+LEASE_SECONDS} or nil
        return record
    end,deadline)
    profile.busy=false;profile.nextWrite=os.clock()+WRITE_INTERVAL
    -- A departing player's Close may time out while UpdateAsync is still yielding.
    -- Once that request drains, flush the newest attributes and release the lease.
    if not release and profile.closing then
        task.defer(function()
            if self.profiles[player]==profile and (not self.shutdownDeadline or os.clock()&lt;self.shutdownDeadline) then
                self:Close(player)
            end
        end)
    end
    if saved then
        if not release then profile.expiresAt=saved.Session.ExpiresAt end
        profile.warned=false
        return true,true
    end
    if reason=="session lost" or reason=="invalid data or unsupported version" then self:_lose(profile,reason)
    elseif not profile.warned then
        profile.warned=true
        warn("[PlayerProgress] Save failed for "..player.UserId.."; retry pending: "..tostring(reason))
    end
    return false,true
end

function PlayerProgress:Save(player)
    local profile=self.profiles[player]
    if not profile or profile.closing then return false end
    return self:_write(profile,false,math.min(os.clock()+REQUEST_SECONDS,self.shutdownDeadline or math.huge))
end

function PlayerProgress:RequestSave(player)
    local profile=self.profiles[player]
    if not profile or not profile.applied or profile.closing or profile.lost then return end
    profile.pending=true
    if profile.worker then return end
    profile.worker=true
    task.spawn(function()
        while self.profiles[player]==profile and profile.pending and not profile.closing and not profile.lost do
            while os.clock()&lt;profile.nextWrite and not profile.closing do task.wait(.1) end
            if profile.closing then break end
            profile.pending=false
            if not self:Save(player) then profile.pending=true end
        end
        profile.worker=false
    end)
end

function PlayerProgress:Autosave()
    local now=os.clock()
    for player,profile in pairs(self.profiles) do
        if profile.applied and not profile.closing and not profile.lost then
            if os.time()&gt;=profile.expiresAt-LEASE_MARGIN then self:_lose(profile,"lease expired")
            elseif now&gt;=profile.nextAutosave then
                profile.nextAutosave=now+AUTOSAVE_SECONDS
                self:RequestSave(player)
            end
        end
    end
end

function PlayerProgress:Close(player,deadline)
    local profile=self.profiles[player]
    if not profile then return true end
    profile.closing=true
    player:SetAttribute("ProgressLoaded",false)
    deadline=math.min(deadline or os.clock()+25,self.shutdownDeadline or math.huge)
    local ok,attempted=self:_write(profile,true,deadline)
    -- An expired waiter does not own finalization: a deferred Close may still need this profile.
    if ok or attempted or profile.lost or (not profile.loading and not profile.loaded) then self.profiles[player]=nil end
    if not ok then warn("[PlayerProgress] Final save failed for "..player.UserId.."; retained cloud record and lease") end
    return ok
end

function PlayerProgress:CloseAll()
    self.shutdownDeadline=os.clock()+25
    local remaining=0
    for player in pairs(self.profiles) do
        remaining+=1
        task.spawn(function() self:Close(player,self.shutdownDeadline);remaining-=1 end)
    end
    while remaining&gt;0 and os.clock()&lt;self.shutdownDeadline do task.wait(.1) end
end

-- Select before any cloud request. Never use temporary data as recovery from a failed load.
-- This branch cannot run on Roblox servers, even if a place has no universe id.
if RunService:IsStudio() and game.GameId==0 then
    local records={}
    local memoryStore={}
    function memoryStore:UpdateAsync(key,transform)
        local record=transform(records[key])
        if record~=nil then records[key]=record end
        return record
    end
    local progress=PlayerProgress.new(memoryStore,function() return true end)
    progress.temporary=true
    warn("[PlayerProgress] Studio temporary progress: NOT SAVED. Unpublished local place; no DataStore access. Progress resets when Play stops.")
    return progress
end

-- Published Studio tests and Roblox servers retain strict cloud loading and session protection.
local liveStore={}
function liveStore:UpdateAsync(key,transform)
    return DataStoreService:GetDataStore(STORE_NAME):UpdateAsync(key,transform)
end
local function budgetAvailable()
    return DataStoreService:GetRequestBudgetForRequestType(Enum.DataStoreRequestType.GetAsync)&gt;0
        and DataStoreService:GetRequestBudgetForRequestType(Enum.DataStoreRequestType.SetIncrementAsync)&gt;0
end

return PlayerProgress.new(liveStore,budgetAvailable)
